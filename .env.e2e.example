COMPOSE_PROJECT_NAME=opsqueue-e2e
WEB_PORT=18080

DB_NAME=ops_queue
DB_ROOT_PASSWORD=e2e-root-password
DB_RUNTIME_USER=ops_runtime
DB_RUNTIME_PASSWORD=e2e-runtime-password

JWT_SIGNING_KEY=e2e-only-signing-key-at-least-32-characters
JWT_COOKIE_SECURE=false

BOOTSTRAP_LEADER_USERNAME=leader
BOOTSTRAP_LEADER_DISPLAY_NAME=端到端组长
BOOTSTRAP_LEADER_PASSWORD=E2e-Bootstrap-Password-1!
